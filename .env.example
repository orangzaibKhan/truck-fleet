# Copy this file to .env and fill in real values. Never commit .env.
# SQLite is used (no separate database server needed - this is what makes the
# app deployable on Hostinger's Business/Cloud plans, which don't support
# PostgreSQL outside a VPS). Defaults to backend/data/app.db; uncomment to override:
# DATABASE_FILE=/absolute/path/to/app.db
JWT_SECRET=generate-a-random-secret-and-never-commit-the-real-one

# Locks down CORS to the real frontend origin in production. Unset = reflect
# any origin (fine for local dev only). Example: https://app.yourdomain.com
# CORS_ORIGIN=https://app.yourdomain.com

# Build-time only (frontend/.env.production, not this file) - the deployed
# API's public URL. Example: https://api.yourdomain.com
# VITE_API_BASE_URL=https://api.yourdomain.com
